rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() >= 5
        && request.auth.token.email.size() <= 160
        && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function authStaffId() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    // Bootstrapped primary dealership manager (verified Google email only)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && authEmailLower() == 'phuocsangspt@gmail.com';
    }

    function hasStaffDoc() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/staff/$(authStaffId()));
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(authStaffId())).data;
    }

    function isActiveStaff() {
      return hasStaffDoc() && staffDoc().isActive == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isActiveStaff() && staffDoc().role == 'quan_ly');
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidRole(role) {
      return role in ['quan_ly', 'le_tan', 'co_van', 'dat_hen'];
    }

    function isValidPermissions(p) {
      return p is map
        && p.keys().hasAll([
          'canAccessDatHen',
          'canCreateAppointments',
          'canEditAppointments',
          'canDeleteAppointments',
          'canAccessLeTan',
          'canCheckInCars',
          'canDeleteReception',
          'canAccessCoVan',
          'canUpdateVehicleStatus',
          'canAccessSettings',
          'canSyncSheets'
        ])
        && p.keys().hasOnly([
          'canAccessDatHen',
          'canCreateAppointments',
          'canEditAppointments',
          'canDeleteAppointments',
          'canAccessLeTan',
          'canCheckInCars',
          'canDeleteReception',
          'canAccessCoVan',
          'canUpdateVehicleStatus',
          'canAccessSettings',
          'canSyncSheets'
        ])
        && p.canAccessDatHen is bool
        && p.canCreateAppointments is bool
        && p.canEditAppointments is bool
        && p.canDeleteAppointments is bool
        && p.canAccessLeTan is bool
        && p.canCheckInCars is bool
        && p.canDeleteReception is bool
        && p.canAccessCoVan is bool
        && p.canUpdateVehicleStatus is bool
        && p.canAccessSettings is bool
        && p.canSyncSheets is bool;
    }

    // =========================================================================
    // Entity Validation Blueprints (Pillar 2 & Pillar 5)
    // =========================================================================
    function isValidStaffAccount(data) {
      return data.keys().hasAll([
          'id', 'email', 'fullName', 'role', 'roleTitle', 'isActive', 'permissions', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'fullName', 'role', 'roleTitle', 'assignedAdvisorName',
          'avatar', 'phone', 'department', 'employeeCode', 'isActive', 'uid',
          'permissions', 'createdAt', 'updatedAt', 'lastLoginAt', 'approvedBy'
        ])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && isValidRole(data.role)
        && data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 100
        && data.isActive is bool
        && isValidPermissions(data.permissions)
        && data.createdAt is string && data.createdAt.size() <= 64
        && isOptionalString(data, 'assignedAdvisorName', 120)
        && isOptionalString(data, 'avatar', 500)
        && isOptionalString(data, 'phone', 30)
        && isOptionalString(data, 'department', 80)
        && isOptionalString(data, 'employeeCode', 40)
        && isOptionalString(data, 'uid', 128)
        && isOptionalString(data, 'updatedAt', 64)
        && isOptionalString(data, 'lastLoginAt', 64)
        && isOptionalString(data, 'approvedBy', 160);
    }

    function isValidAdvisorProfile(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'isActive'])
        && data.keys().hasOnly(['id', 'name', 'role', 'avatar', 'isActive', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.role is string && data.role.size() >= 1 && data.role.size() <= 100
        && data.isActive is bool
        && isOptionalString(data, 'avatar', 500)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isValidAccessRequest(data) {
      return data.keys().hasAll([
          'id', 'uid', 'email', 'fullName', 'requestedRole', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'email', 'fullName', 'avatar', 'requestedRole', 'note', 'status', 'createdAt'
        ])
        && isValidId(data.id)
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.requestedRole in ['le_tan', 'co_van', 'dat_hen']
        && data.status in ['pending', 'rejected']
        && data.createdAt is string && data.createdAt.size() <= 64
        && isOptionalString(data, 'avatar', 500)
        && isOptionalString(data, 'note', 300);
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'id', 'licensePlate', 'advisorName', 'serviceTypes', 'customerName',
          'status', 'priority', 'location', 'appointmentDate', 'appointmentTime',
          'durationMinutes', 'bayId', 'content'
        ])
        && data.keys().hasOnly([
          'id', 'licensePlate', 'advisorName', 'advisorAvatar', 'serviceTypes',
          'customerName', 'phoneNumber', 'bookingStaff', 'status', 'priority',
          'location', 'appointmentDate', 'appointmentTime', 'durationMinutes',
          'bayId', 'bayName', 'content', 'cardColor',
          'createdByUid', 'createdByEmail', 'createdByName',
          'updatedByEmail', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.licensePlate is string && data.licensePlate.size() >= 2 && data.licensePlate.size() <= 30
        && data.advisorName is string && data.advisorName.size() >= 1 && data.advisorName.size() <= 120
        && data.serviceTypes is list && data.serviceTypes.size() >= 1 && data.serviceTypes.size() <= 10
        && data.serviceTypes[0] is string && data.serviceTypes[0].size() <= 80
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.status in ['Chờ Tiếp Nhận', 'Đã Xác Nhận', 'Đang Làm', 'Hoàn Thành', 'Đã Hủy']
        && data.priority in ['Thường', 'Ưu Tiên', 'VIP', 'Gấp', 'Khách Chờ Lấy Liền']
        && data.location is string && data.location.size() <= 100
        && data.appointmentDate is string && data.appointmentDate.size() == 10 && data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.appointmentTime is string && data.appointmentTime.size() == 5 && data.appointmentTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.durationMinutes is number && data.durationMinutes >= 15 && data.durationMinutes <= 480
        && data.bayId is string && data.bayId.size() >= 1 && data.bayId.size() <= 64
        && data.content is string && data.content.size() <= 1000
        && isOptionalString(data, 'advisorAvatar', 500)
        && isOptionalString(data, 'phoneNumber', 30)
        && isOptionalString(data, 'bookingStaff', 120)
        && isOptionalString(data, 'bayName', 64)
        && (!('cardColor' in data) || data.cardColor in ['purple', 'green', 'pink', 'blue', 'amber'])
        && isOptionalString(data, 'createdByUid', 128)
        && isOptionalString(data, 'createdByEmail', 160)
        && isOptionalString(data, 'createdByName', 120)
        && isOptionalString(data, 'updatedByEmail', 160)
        && isOptionalString(data, 'updatedByName', 120)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isValidReceptionEntry(data) {
      return data.keys().hasAll([
          'id', 'licensePlate', 'hasAppointment', 'advisorName',
          'cardTicketNumber', 'cardSlotCode', 'serviceTypes',
          'customerName', 'checkInTime', 'checkInDate', 'status'
        ])
        && data.keys().hasOnly([
          'id', 'licensePlate', 'hasAppointment', 'appointmentId', 'appointmentTime',
          'appointmentContent', 'suggestedAdvisorName',
          'advisorName', 'cardTicketNumber', 'cardSlotCode', 'serviceTypes',
          'customerName', 'phoneNumber', 'checkInTime', 'checkInDate', 'status',
          'notes', 'badgeType', 'deliveryDate', 'carWash', 'customerWaiting',
          'priority', 'location', 'assignedAt', 'assignedByName', 'receivedAt',
          'deliveredAt', 'createdAt',
          'createdByUid', 'createdByEmail', 'createdByName',
          'updatedByEmail', 'updatedByName', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.licensePlate is string && data.licensePlate.size() >= 2 && data.licensePlate.size() <= 30
        && data.hasAppointment is bool
        && data.advisorName is string && data.advisorName.size() <= 120
        && data.cardTicketNumber is string && data.cardTicketNumber.size() <= 20
        && data.cardSlotCode is string && data.cardSlotCode.size() <= 20
        && data.serviceTypes is list && data.serviceTypes.size() >= 1 && data.serviceTypes.size() <= 10
        && data.serviceTypes[0] is string && data.serviceTypes[0].size() <= 80
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.checkInTime is string && data.checkInTime.size() >= 4 && data.checkInTime.size() <= 10
        && data.checkInDate is string && data.checkInDate.size() == 10 && data.checkInDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in [
          'Chờ Tiếp Nhận', 'Đang Tiếp Nhận', 'Đã Tiếp Nhận',
          'Cố Vấn Đang Tiếp Nhận', 'Đã Vào Khoang', 'Đang Sửa Chữa',
          'Chờ Rửa Xe', 'Chờ Giao Xe', 'Đã Giao Xe', 'Hoàn Thành'
        ]
        && isOptionalString(data, 'appointmentId', 128)
        && isOptionalString(data, 'appointmentTime', 40)
        && isOptionalString(data, 'appointmentContent', 1000)
        && isOptionalString(data, 'suggestedAdvisorName', 120)
        && isOptionalString(data, 'phoneNumber', 30)
        && isOptionalString(data, 'notes', 1000)
        && (!('badgeType' in data) || data.badgeType in ['H', 'S', 'T', ''])
        && isOptionalString(data, 'deliveryDate', 40)
        && isOptionalString(data, 'carWash', 60)
        && isOptionalString(data, 'customerWaiting', 60)
        && isOptionalString(data, 'priority', 40)
        && isOptionalString(data, 'location', 100)
        && isOptionalString(data, 'assignedAt', 64)
        && isOptionalString(data, 'assignedByName', 120)
        && isOptionalString(data, 'receivedAt', 64)
        && isOptionalString(data, 'deliveredAt', 64)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'createdByUid', 128)
        && isOptionalString(data, 'createdByEmail', 160)
        && isOptionalString(data, 'createdByName', 120)
        && isOptionalString(data, 'updatedByEmail', 160)
        && isOptionalString(data, 'updatedByName', 120)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isValidAdvisorPickupRequest(data) {
      return data.keys().hasAll(['id', 'advisorUid', 'advisorName', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'advisorUid', 'advisorName', 'advisorAvatar', 'note', 'status', 'createdAt'])
        && isValidId(data.id)
        && data.advisorUid is string && data.advisorUid.size() >= 1 && data.advisorUid.size() <= 128
        && data.advisorName is string && data.advisorName.size() >= 1 && data.advisorName.size() <= 120
        && data.status == 'waiting'
        && data.createdAt is string && data.createdAt.size() <= 64
        && isOptionalString(data, 'advisorAvatar', 500)
        && isOptionalString(data, 'note', 200);
    }

    function isValidWorkshopSettings(data) {
      return data.keys().hasAll(['workshopName', 'branchName'])
        && data.keys().hasOnly([
          'workshopName', 'branchName', 'phoneNumber', 'address',
          'autoSyncInterval', 'allowReceptionCheckInWithoutAppointment',
          'defaultDurationMinutes', 'spreadsheetId', 'spreadsheetUrl',
          'sheetTitle', 'isAutoSyncEnabled', 'syncIntervalSeconds',
          'lastSyncedAt', 'updatedAt'
        ])
        && data.workshopName is string && data.workshopName.size() >= 1 && data.workshopName.size() <= 160
        && data.branchName is string && data.branchName.size() <= 120
        && isOptionalString(data, 'phoneNumber', 30)
        && isOptionalString(data, 'address', 240)
        && (!('autoSyncInterval' in data) || (data.autoSyncInterval is number && data.autoSyncInterval >= 5 && data.autoSyncInterval <= 3600))
        && (!('allowReceptionCheckInWithoutAppointment' in data) || data.allowReceptionCheckInWithoutAppointment is bool)
        && (!('defaultDurationMinutes' in data) || (data.defaultDurationMinutes is number && data.defaultDurationMinutes >= 15 && data.defaultDurationMinutes <= 240))
        && isOptionalString(data, 'spreadsheetId', 160)
        && isOptionalString(data, 'spreadsheetUrl', 300)
        && isOptionalString(data, 'sheetTitle', 160)
        && (!('isAutoSyncEnabled' in data) || data.isAutoSyncEnabled is bool)
        && (!('syncIntervalSeconds' in data) || (data.syncIntervalSeconds is number && data.syncIntervalSeconds >= 10 && data.syncIntervalSeconds <= 3600))
        && isOptionalString(data, 'lastSyncedAt', 80)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id', 'action', 'targetType', 'summary',
          'actorUid', 'actorEmail', 'actorName', 'actorRole', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'action', 'targetType', 'targetId', 'summary',
          'actorUid', 'actorEmail', 'actorName', 'actorRole', 'createdAt'
        ])
        && isValidId(data.id)
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.targetType in ['appointment', 'reception', 'staff', 'settings', 'auth']
        && isOptionalString(data, 'targetId', 128)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.actorEmail is string && data.actorEmail.size() >= 5 && data.actorEmail.size() <= 160
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && isValidRole(data.actorRole)
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // 1. Approved Staff Directory (PII isolated: self-get or Admin only)
    match /staff/{staffId} {
      allow get: if isVerifiedUser() && isValidId(staffId) && (
        staffId == authStaffId() || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().id == staffId
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(staffId)
        && isValidStaffAccount(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && (staffId != 'phuocsangspt_gmail_com' || isBootstrappedAdmin()))
          || (
            staffId == authStaffId()
            && existing().isActive == true
            && incoming().uid == request.auth.uid
            && incoming().email == existing().email
            && incoming().role == existing().role
            && incoming().isActive == existing().isActive
            && incoming().permissions == existing().permissions
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'lastLoginAt', 'avatar', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(staffId)
        && isAdmin()
        && staffId != authStaffId()
        && staffId != 'phuocsangspt_gmail_com';
    }

    // 2. Pending Employee Access Requests (Self-submit + Admin review)
    match /accessRequests/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (
        requestId == authStaffId() || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidAccessRequest(incoming())
        && requestId == authStaffId()
        && incoming().id == requestId
        && incoming().uid == request.auth.uid
        && incoming().email == authEmailLower()
        && incoming().status == 'pending';
      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidAccessRequest(incoming())
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'requestedRole', 'note']);
      allow delete: if isVerifiedUser() && isValidId(requestId) && (
        requestId == authStaffId() || isAdmin()
      );
    }

    // 3. Service Appointments (Role-tiered + Advisor Scope + Terminal State Lock)
    match /appointments/{appointmentId} {
      allow get: if isVerifiedUser() && isValidId(appointmentId) && (
        isAdmin() || (
          isActiveStaff() && (
            staffDoc().permissions.canAccessDatHen == true
            || staffDoc().permissions.canAccessLeTan == true
            || staffDoc().permissions.canAccessCoVan == true
          )
        )
      );
      allow list: if isVerifiedUser() && (
        isAdmin() || (
          isActiveStaff() && (
            staffDoc().permissions.canAccessDatHen == true
            || staffDoc().permissions.canAccessLeTan == true
            || staffDoc().permissions.canAccessCoVan == true
          )
        )
      );
      allow create: if isVerifiedUser()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().id == appointmentId
        && (!('createdByUid' in incoming()) || incoming().createdByUid == request.auth.uid)
        && (
          isAdmin()
          || (isActiveStaff() && staffDoc().permissions.canCreateAppointments == true)
        );
      allow update: if isVerifiedUser()
        && isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().id == existing().id
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (!('createdByUid' in existing()) || incoming().createdByUid == existing().createdByUid)
        && (
          !(existing().status in ['Đã Xác Nhận', 'Chờ Tiếp Nhận', 'Đang Làm', 'Hoàn Thành'])
          || (
            incoming().appointmentDate == existing().appointmentDate
            && incoming().appointmentTime == existing().appointmentTime
            && incoming().durationMinutes == existing().durationMinutes
          )
        )
        && (
          isAdmin()
          || (
            isActiveStaff()
            && staffDoc().permissions.canEditAppointments == true
            && existing().status != 'Hoàn Thành'
            && existing().status != 'Đã Hủy'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'licensePlate', 'advisorName', 'advisorAvatar', 'serviceTypes',
              'customerName', 'phoneNumber', 'bookingStaff', 'status', 'priority',
              'location', 'appointmentDate', 'appointmentTime', 'durationMinutes',
              'bayId', 'bayName', 'content', 'cardColor',
              'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
          || (
            isActiveStaff()
            && staffDoc().role == 'co_van'
            && staffDoc().permissions.canUpdateVehicleStatus == true
            && existing().advisorName == staffDoc().fullName
            && existing().status != 'Hoàn Thành'
            && existing().status != 'Đã Hủy'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'content', 'cardColor', 'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
          || (
            isActiveStaff()
            && staffDoc().permissions.canCheckInCars == true
            && existing().status != 'Hoàn Thành'
            && existing().status != 'Đã Hủy'
            && incoming().status in ['Chờ Tiếp Nhận', 'Đang Làm']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'cardColor', 'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(appointmentId) && (
        isAdmin() || (isActiveStaff() && staffDoc().permissions.canDeleteAppointments == true)
      );
    }

    // 4. Reception Check-in Queue (Lễ Tân + Cố Vấn Scope + Terminal State Lock)
    match /receptionEntries/{entryId} {
      allow get: if isVerifiedUser() && isValidId(entryId) && (
        isAdmin() || (
          isActiveStaff() && (
            staffDoc().permissions.canAccessLeTan == true
            || staffDoc().permissions.canAccessCoVan == true
            || staffDoc().permissions.canAccessDatHen == true
          )
        )
      );
      allow list: if isVerifiedUser() && (
        isAdmin() || (
          isActiveStaff() && (
            staffDoc().permissions.canAccessLeTan == true
            || staffDoc().permissions.canAccessCoVan == true
            || staffDoc().permissions.canAccessDatHen == true
          )
        )
      );
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidReceptionEntry(incoming())
        && incoming().id == entryId
        && (!('createdByUid' in incoming()) || incoming().createdByUid == request.auth.uid)
        && (
          isAdmin()
          || (isActiveStaff() && staffDoc().permissions.canCheckInCars == true)
        );
      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && isValidReceptionEntry(incoming())
        && incoming().id == existing().id
        && (!('createdByUid' in existing()) || incoming().createdByUid == existing().createdByUid)
        && (
          isAdmin()
          || (
            isActiveStaff()
            && staffDoc().permissions.canCheckInCars == true
            && existing().status != 'Hoàn Thành'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'licensePlate', 'hasAppointment', 'appointmentId', 'appointmentTime',
              'appointmentContent', 'suggestedAdvisorName',
              'advisorName', 'cardTicketNumber', 'cardSlotCode', 'serviceTypes',
              'customerName', 'phoneNumber', 'status', 'notes', 'badgeType',
              'deliveryDate', 'carWash', 'customerWaiting', 'priority', 'location',
              'assignedAt', 'assignedByName', 'receivedAt', 'deliveredAt',
              'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
          || (
            isActiveStaff()
            && staffDoc().role == 'co_van'
            && staffDoc().permissions.canUpdateVehicleStatus == true
            && existing().advisorName == staffDoc().fullName
            && existing().status != 'Hoàn Thành'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'serviceTypes', 'appointmentContent', 'status', 'notes',
              'deliveryDate', 'carWash', 'customerWaiting', 'priority', 'location',
              'assignedAt', 'assignedByName', 'receivedAt', 'deliveredAt',
              'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
          || (
            isActiveStaff()
            && staffDoc().role == 'co_van'
            && staffDoc().permissions.canUpdateVehicleStatus == true
            && existing().status == 'Chờ Tiếp Nhận'
            && existing().advisorName == ''
            && incoming().advisorName == staffDoc().fullName
            && incoming().status == 'Đang Tiếp Nhận'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'advisorName', 'status', 'assignedAt', 'assignedByName', 'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
          || (
            isActiveStaff()
            && staffDoc().role == 'co_van'
            && staffDoc().permissions.canUpdateVehicleStatus == true
            && existing().advisorName == staffDoc().fullName
            && existing().status in ['Đang Tiếp Nhận', 'Cố Vấn Đang Tiếp Nhận']
            && incoming().status == 'Chờ Tiếp Nhận'
            && incoming().advisorName == ''
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'advisorName', 'status', 'assignedAt', 'assignedByName', 'updatedByEmail', 'updatedByName', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(entryId) && (
        isAdmin() || (isActiveStaff() && staffDoc().permissions.canDeleteReception == true)
      );
    }

    // 5. Workshop Settings (Readable by active staff, writable by Admin or Sheets sync)
    match /settings/{settingId} {
      allow get: if isVerifiedUser() && isValidId(settingId) && (
        isAdmin() || isActiveStaff()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(settingId)
        && isValidWorkshopSettings(incoming())
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(settingId)
        && isValidWorkshopSettings(incoming())
        && (
          isAdmin()
          || (
            isActiveStaff()
            && staffDoc().permissions.canSyncSheets == true
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'spreadsheetId', 'spreadsheetUrl', 'sheetTitle',
              'isAutoSyncEnabled', 'syncIntervalSeconds', 'lastSyncedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(settingId) && isAdmin();
    }

    // 6. Immutable Audit Logs (Create by active staff for own identity; read only by Admin)
    match /auditLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().actorEmail == authEmailLower()
        && (isAdmin() || isActiveStaff());
      allow update, delete: if false;
    }

    // 7. Non-PII Service Advisor Directory (auto-synced from active co_van accounts)
    match /advisors/{advisorId} {
      allow get: if isVerifiedUser() && isValidId(advisorId) && (isAdmin() || isActiveStaff());
      allow list: if isVerifiedUser() && (isAdmin() || isActiveStaff());
      allow create: if isVerifiedUser()
        && isValidId(advisorId)
        && isValidAdvisorProfile(incoming())
        && incoming().id == advisorId
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(advisorId)
        && isValidAdvisorProfile(incoming())
        && incoming().id == existing().id
        && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(advisorId) && isAdmin();
    }

    // 8. Live 2-Way Advisor Pickup Requests (Advisor -> Reception)
    match /advisorRequests/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (isAdmin() || isActiveStaff());
      allow list: if isVerifiedUser() && (isAdmin() || isActiveStaff());
      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidAdvisorPickupRequest(incoming())
        && requestId == authStaffId()
        && incoming().id == requestId
        && incoming().advisorUid == request.auth.uid
        && (
          isAdmin()
          || (isActiveStaff() && staffDoc().role == 'co_van' && incoming().advisorName == staffDoc().fullName)
        );
      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidAdvisorPickupRequest(incoming())
        && requestId == authStaffId()
        && incoming().id == existing().id
        && incoming().advisorUid == request.auth.uid
        && (
          isAdmin()
          || (isActiveStaff() && staffDoc().role == 'co_van' && incoming().advisorName == staffDoc().fullName)
        );
      allow delete: if isVerifiedUser() && isValidId(requestId) && (
        requestId == authStaffId()
        || isAdmin()
        || (isActiveStaff() && staffDoc().permissions.canCheckInCars == true)
      );
    }
  }
}
